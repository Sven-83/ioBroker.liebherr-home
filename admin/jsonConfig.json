{
    "i18n": true,
    "type": "panel",
    "items": {
        "_headerAccount": {
            "type": "header",
            "text": "Liebherr SmartDevice",
            "size": 2
        },
        "apiKey": {
            "type": "password",
            "label": "API key",
            "help": "Create the key in the SmartDevice app under Settings - HomeAPI. It is shown only once.",
            "validator": "!!(data.apiKey || '').trim()",
            "validatorErrorText": "Please enter the API key",
            "validatorNoSaveOnError": true,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 8,
            "lg": 6,
            "xl": 6
        },
        "_headerConnection": {
            "type": "header",
            "text": "Connection",
            "size": 2,
            "newLine": true
        },
        "useSse": {
            "type": "checkbox",
            "label": "Real-time updates (SSE)",
            "help": "Polling is used as fallback if the real-time connection fails",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "pollInterval": {
            "type": "number",
            "label": "Polling interval",
            "help": "Seconds, minimum 60",
            "min": 60,
            "max": 3600,
            "step": 1,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        }
    }
}
